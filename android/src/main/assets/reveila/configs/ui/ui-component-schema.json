{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "UIComponentSchema",
    "type": "object",
    "required": [
        "id",
        "type",
        "props"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "type": {
            "type": "string",
            "enum": [
                "Container",
                "TextField",
                "Button",
                "Dropdown",
                "Text"
            ]
        },
        "props": {
            "type": "object"
        },
        "binding": {
            "type": "string"
        }
    },
    "additionalProperties": false
}

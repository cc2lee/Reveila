[
    {
        "component": {
            "name": "UsageTracker",
            "class": "com.reveila.ai.UsageTracker",
            "thread-safe": true,
            "dependencies": [
                "DataService"
            ]
        }
    },
    {
        "component": {
            "name": "InboundWebhookService",
            "class": "com.reveila.ai.InboundWebhookService",
            "thread-safe": true,
            "dependencies": [
                "ManagedInvocation",
                "OrchestrationService",
                "FlightRecorder",
                "LlmProviderFactory"
            ]
        }
    },
    {
        "component": {
            "name": "DataService",
            "class": "com.reveila.service.DataService",
            "description": "Bridges the Reveila API and the platform dependent repositories.",
            "thread-safe": true
        }
    },
    {
        "component": {
            "name": "AutonomousAgent",
            "class": "com.reveila.ai.AutonomousAgent",
            "description": "Performs autonomous agent tasks.",
            "thread-safe": true,
            "dependencies": [
                "AgenticFabric",
                "OrchestrationService",
                "DataService"
            ],
            "runnable": {
                "delay.seconds": 60,
                "interval.seconds": 30,
                "method.name": "doTask"
            }
        }
    },
    {
        "component": {
            "name": "MetadataRegistry",
            "class": "com.reveila.safety.MetadataRegistry",
            "description": "Registry for all plugin manifests and capabilities.",
            "thread-safe": true
        }
    },
    {
        "component": {
            "name": "SecretManager",
            "class": "com.reveila.safety.SecretManager",
            "description": "Manages JIT credentials for plugins.",
            "thread-safe": true,
            "dependencies": [
                "DataService"
            ]
        }
    },
    {
        "component": {
            "name": "AgentSessionManager",
            "class": "com.reveila.ai.AgentSessionManager",
            "description": "Manages agentic sessions and context persistence.",
            "thread-safe": true,
            "dependencies": [
                "DataService"
            ]
        }
    },
    {
        "component": {
            "name": "OrchestrationService",
            "class": "com.reveila.ai.OrchestrationService",
            "description": "Orchestrates multi-agent workflows.",
            "thread-safe": true,
            "dependencies": [
                "AgentSessionManager",
                "DataService"
            ]
        }
    },
    {
        "component": {
            "name": "LlmProviderFactory",
            "class": "com.reveila.ai.LlmProviderFactory",
            "description": "Factory for LLM providers.",
            "thread-safe": true,
            "dependencies": [],
            "methods": [
                {
                    "name": "loadProviders",
                    "description": "Reloads LLM providers from configuration."
                },
                {
                    "name": "getSettings",
                    "description": "Reads configuration settings for a given tab."
                },
                {
                    "name": "setSettings",
                    "description": "Updates configuration settings for a given tab."
                },
                {
                    "name": "saveSettings",
                    "description": "Persists configuration settings and reloads providers."
                }
            ]
        }
    },
    {
        "component": {
            "name": "IntentValidator",
            "class": "com.reveila.ai.AiIntentValidator",
            "description": "Validates agent intents using Gemini.",
            "thread-safe": true,
            "dependencies": []
        }
    },
    {
        "component": {
            "name": "SchemaEnforcer",
            "class": "com.reveila.safety.JsonSchemaEnforcer",
            "description": "Enforces JSON schemas for tool calls.",
            "thread-safe": true,
            "dependencies": [
                "MetadataRegistry"
            ]
        }
    },
    {
        "component": {
            "name": "ManagedInvocation",
            "class": "com.reveila.safety.ManagedInvocation",
            "description": "The sovereign entry point for all tool calls.",
            "thread-safe": true,
            "dependencies": [
                "IntentValidator",
                "SchemaEnforcer",
                "GuardedRuntime",
                "FlightRecorder",
                "MetadataRegistry",
                "SecretManager",
                "OrchestrationService",
                "LlmProviderFactory"
            ]
        }
    },
    {
        "component": {
            "name": "KnowledgeVault",
            "class": "com.reveila.ai.KnowledgeVault",
            "description": "Sovereign knowledge management, vector store and document embedding index.",
            "thread-safe": true
        }
    },
    {
        "component": {
            "name": "AgenticFabric",
            "class": "com.reveila.ai.AgenticFabric",
            "description": "Orchestrates complex multi-agent workflows.",
            "thread-safe": true,
            "dependencies": [
                "ManagedInvocation",
                "AgentSessionManager",
                "KnowledgeVault"
            ],
            "arguments": [
                {
                    "name": "aiLoopLimit",
                    "type": "int",
                    "value": 5
                }
            ]
        }
    },
    {
        "component": {
            "name": "HttpClientService",
            "version": "1",
            "displayName": "Http Client Service",
            "description": "Provides HTTP client capabilities for making web requests.",
            "author": "Charles Lee",
            "class": "com.reveila.service.HttpClientService",
            "arguments": [
                {
                    "name": "connectTimeout",
                    "type": "long",
                    "value": 10
                },
                {
                    "name": "writeTimeout",
                    "type": "long",
                    "value": 10
                },
                {
                    "name": "readTimeout",
                    "type": "long",
                    "value": 30
                }
            ]
        }
    },
    {
        "component": {
            "name": "ResumableDownloadManager",
            "class": "com.reveila.tools.download.ResumableDownloadManager",
            "description": "Generic resumable download manager with storage preflight, pause/resume/cancel, SHA-256 verification, and periodic temp housekeeping.",
            "thread-safe": true,
            "runnable": {
                "delay.seconds": 60,
                "interval.seconds": 3600,
                "method.name": "runHousekeeping"
            }
        }
    },
    {
        "component": {
            "name": "remote.reveila",
            "class": "com.reveila.service.RemoteService",
            "version": "1",
            "description": "Invokes services, components, and plugins hosted on remote Reveila cluster nodes.",
            "thread-safe": true
        }
    },
    {
        "component": {
            "name": "ClusterService",
            "class": "com.reveila.cluster.ClusterService",
            "description": "Resilient, self-healing cluster manager handling Lead/Worker coordination, active service routing, native state sync, and dynamic leader election without PostgreSQL dependency.",
            "thread-safe": true,
            "dependencies": [
                "remote.reveila"
            ]
        }
    }
]